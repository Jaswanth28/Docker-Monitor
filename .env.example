# ── Copy to .env and fill in ──────────────────────────────────────────
# Path (as seen from WSL) where the dashboard writes new compose stacks.
STACKS_DIR=/mnt/l/Docker_Monitor/stacks

DASHBOARD_PORT=3000
INFISICAL_PORT=8085

# ── Infisical server bootstrap (generate once, never change afterwards) ──
#   openssl rand -hex 16   -> INFISICAL_ENCRYPTION_KEY (must be 16 bytes hex = 32 chars)
#   openssl rand -base64 32 -> INFISICAL_AUTH_SECRET
#   openssl rand -hex 16   -> INFISICAL_DB_PASSWORD
INFISICAL_ENCRYPTION_KEY=52683dc7409b25b2fd604e26df9d551f
INFISICAL_AUTH_SECRET=RxTRPiNFYgfqChcgsUVG+od9c7epjb+w32fkropMDrA=
INFISICAL_DB_PASSWORD=b86eaee5299c000110df116c025a456e 

# ── Machine identity the API uses to read secrets from Infisical ──────
# Created in the Infisical UI (Project -> Access Control -> Machine Identities,
# Universal Auth). Leave blank on first boot; fill after step 3 in README.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=prod
INFISICAL_SECRET_PATH=/

# ── Fallback secrets (ONLY used while Infisical is not configured) ────
# Once the machine identity above is set, move these into Infisical and
# delete them from here. Generate hashes with:  python scripts/hash_password.py
JWT_SECRET=hE9PnymzQQAAAlmfFwgtMnvBRP/eFz9PZwk9X1vg8jw=
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
VIEWER_USERNAME=viewer
VIEWER_PASSWORD_HASH=
